<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">

  <!--
    Pandorabots gestisce solo la PARTE NLP: riconosce la richiesta di
    disponibilità libro e restituisce un marcatore "TITLE:<titolo>".
    Il backend Vercel intercetta questo marcatore, fa il lookup OPAC e
    risponde al frontend.

    Per qualsiasi altra frase (saluti, fallback) Pandorabots risponde
    normalmente in italiano.
  -->

  <!-- ============================================================ -->
  <!-- ROUTER: tutti i pattern di ricerca confluiscono qui          -->
  <!-- ============================================================ -->
  <category>
    <pattern>RICERCA *</pattern>
    <template>TITLE:<star/></template>
  </category>

  <!-- ============================================================ -->
  <!-- VARIANTI DELLA DOMANDA UTENTE                                -->
  <!-- Doppia forma con e senza accento per coprire la              -->
  <!-- normalizzazione di Pandorabots.                               -->
  <!-- ============================================================ -->
  <category>
    <pattern>IL LIBRO * E DISPONIBILE A LODI</pattern>
    <template><srai>RICERCA <star/></srai></template>
  </category>
  <category>
    <pattern>IL LIBRO * È DISPONIBILE A LODI</pattern>
    <template><srai>RICERCA <star/></srai></template>
  </category>
  <category>
    <pattern>IL LIBRO * E DISPONIBILE</pattern>
    <template><srai>RICERCA <star/></srai></template>
  </category>
  <category>
    <pattern>IL LIBRO * È DISPONIBILE</pattern>
    <template><srai>RICERCA <star/></srai></template>
  </category>
  <category>
    <pattern>LIBRO * E DISPONIBILE A LODI</pattern>
    <template><srai>RICERCA <star/></srai></template>
  </category>
  <category>
    <pattern>LIBRO * È DISPONIBILE A LODI</pattern>
    <template><srai>RICERCA <star/></srai></template>
  </category>
  <category>
    <pattern>AVETE IL LIBRO *</pattern>
    <template><srai>RICERCA <star/></srai></template>
  </category>
  <category>
    <pattern>AVETE * A LODI</pattern>
    <template><srai>RICERCA <star/></srai></template>
  </category>
  <category>
    <pattern>AVETE * IN BIBLIOTECA</pattern>
    <template><srai>RICERCA <star/></srai></template>
  </category>
  <category>
    <pattern>AVETE *</pattern>
    <template><srai>RICERCA <star/></srai></template>
  </category>
  <category>
    <pattern>CERCO IL LIBRO *</pattern>
    <template><srai>RICERCA <star/></srai></template>
  </category>
  <category>
    <pattern>CERCO *</pattern>
    <template><srai>RICERCA <star/></srai></template>
  </category>
  <category>
    <pattern>VORREI IL LIBRO *</pattern>
    <template><srai>RICERCA <star/></srai></template>
  </category>
  <category>
    <pattern>VORREI *</pattern>
    <template><srai>RICERCA <star/></srai></template>
  </category>
  <category>
    <pattern>C E * IN BIBLIOTECA</pattern>
    <template><srai>RICERCA <star/></srai></template>
  </category>
  <category>
    <pattern>CE * IN BIBLIOTECA</pattern>
    <template><srai>RICERCA <star/></srai></template>
  </category>

  <!-- ============================================================ -->
  <!-- DIALOGO NATURALE                                              -->
  <!-- ============================================================ -->
  <category>
    <pattern>CIAO</pattern>
    <template>Ciao! Sono il bot della biblioteca di Lodi. Chiedimi se un libro è disponibile, esempio: "Avete 1984 a Lodi?"</template>
  </category>
  <category>
    <pattern>BUONGIORNO</pattern>
    <template><srai>CIAO</srai></template>
  </category>
  <category>
    <pattern>BUONASERA</pattern>
    <template><srai>CIAO</srai></template>
  </category>
  <category>
    <pattern>SALVE</pattern>
    <template><srai>CIAO</srai></template>
  </category>
  <category>
    <pattern>GRAZIE</pattern>
    <template>Prego! Se vuoi cercare un altro libro, dimmi il titolo.</template>
  </category>
  <category>
    <pattern>CHI SEI</pattern>
    <template>Sono un assistente virtuale del Sistema Bibliotecario Lodigiano. Posso dirti se un libro è disponibile alla Biblioteca Comunale Laudense.</template>
  </category>

  <!-- Fallback -->
  <category>
    <pattern>*</pattern>
    <template>Non sono sicuro di aver capito. Prova così: "Avete 1984 a Lodi?" oppure "Cerco Il nome della rosa".</template>
  </category>

</aiml>
